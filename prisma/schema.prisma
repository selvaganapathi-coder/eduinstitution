generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
  moduleFormat = "esm"
  runtime = "workerd"
  importFileExtension = "ts"
}

generator seedClient {
  provider = "prisma-client"
  output = "../src/generated/prisma-node"
  moduleFormat = "esm"
  runtime = "nodejs"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
  REVOKED
}

enum RoleScope {
  SYSTEM
  TENANT
}

enum AcademicYearStatus {
  ACTIVE
  ARCHIVED
}

enum AcademicTermStatus {
  ACTIVE
  ARCHIVED
}

enum AcademicGroupType {
  CLASS
  SECTION
  COHORT
  BATCH
  SEMESTER
  GROUP
}

enum AcademicGroupStatus {
  ACTIVE
  ARCHIVED
}

enum StudentAcademicGroupMembershipStatus {
  ACTIVE
  COMPLETED
  WITHDRAWN
  ARCHIVED
}

enum AttendanceMode {
  DAILY
  SESSION
}

enum AttendanceSessionStatus {
  OPEN
  FINALIZED
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum InstitutionTypeStatus {
  ACTIVE
  ARCHIVED
}

enum DepartmentStatus {
  ACTIVE
  ARCHIVED
}

enum ProgramStatus {
  ACTIVE
  ARCHIVED
}

enum ProgramType {
  DEGREE
  DIPLOMA
  CERTIFICATE
  OTHER
}

enum CourseStatus {
  ACTIVE
  ARCHIVED
}

enum CourseType {
  CORE
  ELECTIVE
  PRACTICAL
  PROJECT
  OTHER
}

enum StudentStatus {
  ACTIVE
  ARCHIVED
}

enum GuardianStatus {
  ACTIVE
  ARCHIVED
}

enum StaffType {
  TEACHING
  NON_TEACHING
}

enum StaffStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
  ARCHIVED
}

enum StudentEnrollmentStatus {
  ACTIVE
  COMPLETED
  WITHDRAWN
  ARCHIVED
}

model Tenant {
  id String @id @default(cuid())
  name String
  slug String @unique
  institutionTypeId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  institutionType InstitutionType? @relation(fields: [institutionTypeId], references: [id], onDelete: SetNull)
  memberships Membership[]
  roles Role[]
  sessions Session[]
  academicYears AcademicYear[]
  academicGroups AcademicGroup[]
  studentAcademicGroupMemberships StudentAcademicGroupMembership[]
  attendanceSessions AttendanceSession[]
  attendanceRecords AttendanceRecord[]
  departments Department[]
  programs Program[]
  courses Course[]
  students Student[]
  guardians Guardian[]
  studentGuardians StudentGuardian[]
  studentEnrollments StudentEnrollment[]
  staffMembers StaffMember[]
  @@index([createdAt])
  @@index([institutionTypeId])
}

model InstitutionType {
  id String @id @default(cuid())
  code String @unique
  name String
  description String?
  status InstitutionTypeStatus @default(ACTIVE)
  isSystem Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenants Tenant[]
  capabilities InstitutionTypeCapability[]
  @@index([status, name])
}

model InstitutionCapability {
  id String @id @default(cuid())
  code String @unique
  name String
  description String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  institutionTypes InstitutionTypeCapability[]
  @@index([name])
}

model InstitutionTypeCapability {
  institutionTypeId String
  capabilityId String
  enabled Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  institutionType InstitutionType @relation(fields: [institutionTypeId], references: [id], onDelete: Cascade)
  capability InstitutionCapability @relation(fields: [capabilityId], references: [id], onDelete: Cascade)
  @@id([institutionTypeId, capabilityId])
  @@index([capabilityId])
}

model User {
  id String @id @default(cuid())
  email String @unique
  name String?
  passwordHash String?
  emailVerified DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  memberships Membership[]
  sessions Session[]
  @@index([createdAt])
}

model Membership {
  id String @id @default(cuid())
  userId String
  tenantId String
  status MembershipStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  roles Role[]
  student Student?
  guardian Guardian?
  @@unique([userId, tenantId])
  @@index([tenantId, status])
  @@index([userId, status])
}

model Role {
  id String @id @default(cuid())
  tenantId String?
  name String
  description String?
  scope RoleScope @default(TENANT)
  isSystem Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberships Membership[]
  permissions RolePermission[]
  @@unique([tenantId, name])
  @@index([tenantId, scope])
}

model Permission {
  id String @id @default(cuid())
  code String @unique
  description String?
  createdAt DateTime @default(now())
  roles RolePermission[]
}

model RolePermission {
  roleId String
  permissionId String
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  @@id([roleId, permissionId])
  @@index([permissionId])
}

model Session {
  id String @id @default(cuid())
  userId String
  tenantId String
  tokenHash String @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  lastSeenAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
  @@index([tenantId, expiresAt])
}

model AcademicYear {
  id String @id @default(cuid())
  tenantId String
  name String
  startDate DateTime
  endDate DateTime
  isCurrent Boolean @default(false)
  status AcademicYearStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  terms AcademicTerm[]
  academicGroups AcademicGroup[]
  studentEnrollments StudentEnrollment[]
  @@unique([tenantId, name])
  @@index([tenantId, status])
  @@index([tenantId, isCurrent])
}

model AcademicTerm {
  id String @id @default(cuid())
  academicYearId String
  name String
  startDate DateTime
  endDate DateTime
  sortOrder Int
  status AcademicTermStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  @@unique([academicYearId, name])
  @@index([academicYearId, status, sortOrder])
}

model AcademicGroup {
  id String @id @default(cuid())
  tenantId String
  academicYearId String
  parentGroupId String?
  type AcademicGroupType
  name String
  code String?
  sortOrder Int @default(0)
  status AcademicGroupStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  parentGroup AcademicGroup? @relation("AcademicGroupHierarchy", fields: [parentGroupId], references: [id], onDelete: Restrict)
  childGroups AcademicGroup[] @relation("AcademicGroupHierarchy")
  memberships StudentAcademicGroupMembership[]
  attendanceSessions AttendanceSession[]
  @@unique([tenantId, academicYearId, type, name])
  @@index([tenantId, academicYearId, status, sortOrder])
  @@index([tenantId, parentGroupId, status, sortOrder])
}

model StudentAcademicGroupMembership {
  id String @id @default(cuid())
  tenantId String
  studentId String
  academicGroupId String
  status StudentAcademicGroupMembershipStatus @default(ACTIVE)
  startDate DateTime @default(now())
  endDate DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicGroup AcademicGroup @relation(fields: [academicGroupId], references: [id], onDelete: Cascade)
  @@unique([studentId, academicGroupId])
  @@index([tenantId, studentId, status])
  @@index([tenantId, academicGroupId, status])
}

model AttendanceSession {
  id String @id @default(cuid())
  tenantId String
  academicGroupId String
  attendanceDate DateTime
  mode AttendanceMode @default(DAILY)
  status AttendanceSessionStatus @default(OPEN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  academicGroup AcademicGroup @relation(fields: [academicGroupId], references: [id], onDelete: Cascade)
  records AttendanceRecord[]
  @@unique([academicGroupId, attendanceDate, mode])
  @@index([tenantId, attendanceDate, status])
  @@index([tenantId, academicGroupId, attendanceDate])
}

model AttendanceRecord {
  id String @id @default(cuid())
  tenantId String
  attendanceSessionId String
  studentId String
  status AttendanceStatus
  markedAt DateTime @default(now())
  remarks String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  attendanceSession AttendanceSession @relation(fields: [attendanceSessionId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  @@unique([attendanceSessionId, studentId])
  @@index([tenantId, studentId, markedAt])
}

model Department {
  id String @id @default(cuid())
  tenantId String
  name String
  code String
  description String?
  displayOrder Int @default(0)
  status DepartmentStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  programs Program[]
  studentEnrollments StudentEnrollment[]
  staffMembers StaffMember[]
  @@unique([tenantId, code])
  @@index([tenantId, status, displayOrder])
}

model Program {
  id String @id @default(cuid())
  tenantId String
  departmentId String
  name String
  code String
  type ProgramType @default(DEGREE)
  durationMonths Int?
  description String?
  status ProgramStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  courses Course[]
  studentEnrollments StudentEnrollment[]
  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@index([departmentId, status])
}

model Course {
  id String @id @default(cuid())
  tenantId String
  programId String
  name String
  code String
  description String?
  type CourseType @default(CORE)
  credits Int?
  weeklyHours Int?
  displayOrder Int @default(0)
  status CourseStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  program Program @relation(fields: [programId], references: [id], onDelete: Restrict)
  @@unique([tenantId, code])
  @@index([tenantId, status, displayOrder])
  @@index([programId, status, displayOrder])
}

model Student {
  id String @id @default(cuid())
  tenantId String
  membershipId String? @unique
  studentNumber String
  firstName String
  middleName String?
  lastName String
  email String?
  phone String?
  alternatePhone String?
  dateOfBirth DateTime?
  gender String?
  bloodGroup String?
  nationality String?
  religion String?
  category String?
  motherTongue String?
  addressLine1 String?
  addressLine2 String?
  city String?
  state String?
  postalCode String?
  country String?
  guardianName String?
  guardianRelation String?
  guardianPhone String?
  guardianEmail String?
  admissionDate DateTime?
  admissionType String?
  quota String?
  photoUrl String?
  status StudentStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  membership Membership? @relation(fields: [membershipId], references: [id], onDelete: SetNull)
  guardians StudentGuardian[]
  enrollments StudentEnrollment[]
  academicGroupMemberships StudentAcademicGroupMembership[]
  attendanceRecords AttendanceRecord[]
  @@unique([tenantId, studentNumber])
  @@index([tenantId, status, lastName, firstName])
  @@index([tenantId, email])
  @@index([tenantId, phone])
}

model Guardian {
  id String @id @default(cuid())
  tenantId String
  membershipId String? @unique
  firstName String
  lastName String
  email String?
  phone String?
  alternatePhone String?
  addressLine1 String?
  addressLine2 String?
  city String?
  state String?
  postalCode String?
  country String?
  status GuardianStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  membership Membership? @relation(fields: [membershipId], references: [id], onDelete: SetNull)
  students StudentGuardian[]
  @@index([tenantId, status, lastName, firstName])
  @@index([tenantId, email])
  @@index([tenantId, phone])
}

model StudentGuardian {
  id String @id @default(cuid())
  tenantId String
  studentId String
  guardianId String
  relationship String
  isPrimary Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardian Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  @@unique([studentId, guardianId])
  @@index([tenantId, studentId])
  @@index([tenantId, guardianId])
}

model StudentEnrollment {
  id String @id @default(cuid())
  tenantId String
  studentId String
  academicYearId String
  departmentId String
  programId String
  enrollmentNumber String
  status StudentEnrollmentStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  program Program @relation(fields: [programId], references: [id], onDelete: Restrict)
  @@unique([tenantId, enrollmentNumber])
  @@unique([studentId, academicYearId])
  @@index([tenantId, status, academicYearId])
  @@index([tenantId, departmentId, status])
  @@index([tenantId, programId, status])
  @@index([studentId, status])
}

model StaffMember {
  id String @id @default(cuid())
  tenantId String
  employeeNumber String
  firstName String
  lastName String
  email String?
  phone String?
  photoUrl String?
  dateOfBirth DateTime?
  gender String?
  address String?
  staffType StaffType
  designation String
  departmentId String?
  employmentType String
  joiningDate DateTime
  roleName String?
  accessLevel String?
  status StaffStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  @@unique([tenantId, employeeNumber])
  @@index([tenantId, status, lastName, firstName])
  @@index([tenantId, staffType, status])
  @@index([tenantId, departmentId, status])
  @@index([tenantId, email])
}
