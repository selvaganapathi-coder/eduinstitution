generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
  moduleFormat = "esm"
  runtime = "workerd"
  importFileExtension = "ts"
}

generator seedClient {
  provider = "prisma-client"
  output = "../src/generated/prisma-node"
  moduleFormat = "esm"
  runtime = "nodejs"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum MembershipStatus { ACTIVE INVITED SUSPENDED REVOKED }
enum RoleScope { SYSTEM TENANT }
enum AcademicYearStatus { ACTIVE ARCHIVED }
enum AcademicTermStatus { ACTIVE ARCHIVED }
enum InstitutionTypeStatus { ACTIVE ARCHIVED }
enum DepartmentStatus { ACTIVE ARCHIVED }
enum ProgramStatus { ACTIVE ARCHIVED }
enum ProgramType { DEGREE DIPLOMA CERTIFICATE OTHER }
enum CourseStatus { ACTIVE ARCHIVED }
enum CourseType { CORE ELECTIVE PRACTICAL PROJECT OTHER }
enum StudentStatus { ACTIVE ARCHIVED }
enum StaffType { TEACHING NON_TEACHING }
enum StaffStatus { ACTIVE INACTIVE ON_LEAVE ARCHIVED }
enum StudentEnrollmentStatus { ACTIVE COMPLETED WITHDRAWN ARCHIVED }
enum AttendanceSessionStatus { DRAFT ACTIVE LOCKED CANCELLED }
enum AttendanceSessionType { FULL_DAY MORNING AFTERNOON PERIOD SUBJECT_SESSION LECTURE LAB TUTORIAL CUSTOM }
enum StudentAttendanceStatus { PRESENT ABSENT LATE EXCUSED }

model Tenant {
  id String @id @default(cuid())
  name String
  slug String @unique
  institutionTypeId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  institutionType InstitutionType? @relation(fields: [institutionTypeId], references: [id], onDelete: SetNull)
  memberships Membership[]
  roles Role[]
  sessions Session[]
  academicYears AcademicYear[]
  departments Department[]
  programs Program[]
  courses Course[]
  students Student[]
  studentEnrollments StudentEnrollment[]
  staffMembers StaffMember[]
  attendanceScopes StaffAttendanceScope[]
  attendanceSessions AttendanceSession[]
  studentAttendances StudentAttendance[]
  @@index([createdAt])
  @@index([institutionTypeId])
}

model InstitutionType {
  id String @id @default(cuid())
  code String @unique
  name String
  description String?
  status InstitutionTypeStatus @default(ACTIVE)
  isSystem Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenants Tenant[]
  capabilities InstitutionTypeCapability[]
  @@index([status, name])
}

model InstitutionCapability {
  id String @id @default(cuid())
  code String @unique
  name String
  description String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  institutionTypes InstitutionTypeCapability[]
  @@index([name])
}

model InstitutionTypeCapability {
  institutionTypeId String
  capabilityId String
  enabled Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  institutionType InstitutionType @relation(fields: [institutionTypeId], references: [id], onDelete: Cascade)
  capability InstitutionCapability @relation(fields: [capabilityId], references: [id], onDelete: Cascade)
  @@id([institutionTypeId, capabilityId])
  @@index([capabilityId])
}

model User {
  id String @id @default(cuid())
  email String @unique
  name String?
  passwordHash String?
  emailVerified DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  memberships Membership[]
  sessions Session[]
  attendanceSessionsCreated AttendanceSession[] @relation("AttendanceSessionCreatedBy")
  attendanceSessionsUpdated AttendanceSession[] @relation("AttendanceSessionUpdatedBy")
  attendanceSessionsLocked AttendanceSession[] @relation("AttendanceSessionLockedBy")
  studentAttendancesMarked StudentAttendance[] @relation("StudentAttendanceMarkedBy")
  studentAttendancesUpdated StudentAttendance[] @relation("StudentAttendanceUpdatedBy")
  @@index([createdAt])
}

model Membership {
  id String @id @default(cuid())
  userId String
  tenantId String
  status MembershipStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  roles Role[]
  staffMember StaffMember?
  @@unique([userId, tenantId])
  @@index([tenantId, status])
  @@index([userId, status])
}

model Role {
  id String @id @default(cuid())
  tenantId String?
  name String
  description String?
  scope RoleScope @default(TENANT)
  isSystem Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberships Membership[]
  permissions RolePermission[]
  @@unique([tenantId, name])
  @@index([tenantId, scope])
}

model Permission {
  id String @id @default(cuid())
  code String @unique
  description String?
  createdAt DateTime @default(now())
  roles RolePermission[]
}

model RolePermission {
  roleId String
  permissionId String
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  @@id([roleId, permissionId])
  @@index([permissionId])
}

model Session {
  id String @id @default(cuid())
  userId String
  tenantId String
  tokenHash String @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  lastSeenAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
  @@index([tenantId, expiresAt])
}

model AcademicYear {
  id String @id @default(cuid())
  tenantId String
  name String
  startDate DateTime
  endDate DateTime
  isCurrent Boolean @default(false)
  status AcademicYearStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  terms AcademicTerm[]
  studentEnrollments StudentEnrollment[]
  attendanceSessions AttendanceSession[]
  @@unique([tenantId, name])
  @@index([tenantId, status])
  @@index([tenantId, isCurrent])
}

model AcademicTerm {
  id String @id @default(cuid())
  academicYearId String
  name String
  startDate DateTime
  endDate DateTime
  sortOrder Int
  status AcademicTermStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  @@unique([academicYearId, name])
  @@index([academicYearId, status, sortOrder])
}

model Department {
  id String @id @default(cuid())
  tenantId String
  name String
  code String
  description String?
  displayOrder Int @default(0)
  status DepartmentStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  programs Program[]
  studentEnrollments StudentEnrollment[]
  staffMembers StaffMember[]
  attendanceScopes StaffAttendanceScope[]
  attendanceSessions AttendanceSession[]
  @@unique([tenantId, code])
  @@index([tenantId, status, displayOrder])
}

model Program {
  id String @id @default(cuid())
  tenantId String
  departmentId String
  name String
  code String
  type ProgramType @default(DEGREE)
  durationMonths Int?
  description String?
  status ProgramStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  courses Course[]
  studentEnrollments StudentEnrollment[]
  attendanceScopes StaffAttendanceScope[]
  attendanceSessions AttendanceSession[]
  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@index([departmentId, status])
}

model Course {
  id String @id @default(cuid())
  tenantId String
  programId String
  name String
  code String
  description String?
  type CourseType @default(CORE)
  credits Int?
  weeklyHours Int?
  displayOrder Int @default(0)
  status CourseStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  program Program @relation(fields: [programId], references: [id], onDelete: Restrict)
  attendanceSessions AttendanceSession[]
  @@unique([tenantId, code])
  @@index([tenantId, status, displayOrder])
  @@index([programId, status, displayOrder])
}

model Student {
  id String @id @default(cuid())
  tenantId String
  studentNumber String
  firstName String
  middleName String?
  lastName String
  email String?
  phone String?
  alternatePhone String?
  dateOfBirth DateTime?
  gender String?
  bloodGroup String?
  nationality String?
  religion String?
  category String?
  motherTongue String?
  addressLine1 String?
  addressLine2 String?
  city String?
  state String?
  postalCode String?
  country String?
  guardianName String?
  guardianRelation String?
  guardianPhone String?
  guardianEmail String?
  admissionDate DateTime?
  admissionType String?
  quota String?
  photoUrl String?
  status StudentStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  enrollments StudentEnrollment[]
  attendances StudentAttendance[]
  @@unique([tenantId, studentNumber])
  @@index([tenantId, status, lastName, firstName])
  @@index([tenantId, email])
  @@index([tenantId, phone])
}

model StudentEnrollment {
  id String @id @default(cuid())
  tenantId String
  studentId String
  academicYearId String
  departmentId String
  programId String
  enrollmentNumber String
  status StudentEnrollmentStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  program Program @relation(fields: [programId], references: [id], onDelete: Restrict)
  @@unique([tenantId, enrollmentNumber])
  @@unique([studentId, academicYearId])
  @@index([tenantId, status, academicYearId])
  @@index([tenantId, departmentId, status])
  @@index([tenantId, programId, status])
  @@index([studentId, status])
}

model StaffMember {
  id String @id @default(cuid())
  tenantId String
  membershipId String? @unique
  employeeNumber String
  firstName String
  lastName String
  email String?
  phone String?
  photoUrl String?
  dateOfBirth DateTime?
  gender String?
  address String?
  staffType StaffType
  designation String
  departmentId String?
  employmentType String
  joiningDate DateTime
  roleName String?
  accessLevel String?
  status StaffStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  membership Membership? @relation(fields: [membershipId], references: [id], onDelete: SetNull)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  attendanceScopes StaffAttendanceScope[]
  @@unique([tenantId, employeeNumber])
  @@index([tenantId, status, lastName, firstName])
  @@index([tenantId, staffType, status])
  @@index([tenantId, departmentId, status])
  @@index([tenantId, email])
}

model StaffAttendanceScope {
  id String @id @default(cuid())
  tenantId String
  staffMemberId String
  departmentId String?
  programId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staffMember StaffMember @relation(fields: [staffMemberId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  program Program? @relation(fields: [programId], references: [id], onDelete: Cascade)
  @@index([tenantId, staffMemberId])
  @@index([tenantId, departmentId])
  @@index([tenantId, programId])
}

model AttendanceSession {
  id String @id @default(cuid())
  tenantId String
  academicYearId String
  departmentId String?
  programId String?
  courseId String?
  attendanceDate DateTime
  sessionType AttendanceSessionType
  sessionLabel String?
  status AttendanceSessionStatus @default(DRAFT)
  createdByUserId String
  updatedByUserId String?
  lockedAt DateTime?
  lockedByUserId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  program Program? @relation(fields: [programId], references: [id], onDelete: SetNull)
  course Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)
  createdByUser User @relation("AttendanceSessionCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedByUser User? @relation("AttendanceSessionUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  lockedByUser User? @relation("AttendanceSessionLockedBy", fields: [lockedByUserId], references: [id], onDelete: SetNull)
  studentAttendances StudentAttendance[]

  @@index([tenantId, attendanceDate])
  @@index([tenantId, academicYearId])
  @@index([tenantId, departmentId])
  @@index([tenantId, programId])
  @@index([tenantId, courseId])
  @@index([tenantId, status])
}

model StudentAttendance {
  id String @id @default(cuid())
  tenantId String
  attendanceSessionId String
  studentId String
  status StudentAttendanceStatus @default(PRESENT)
  remarks String?
  markedByUserId String
  updatedByUserId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  attendanceSession AttendanceSession @relation(fields: [attendanceSessionId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Restrict)
  markedByUser User @relation("StudentAttendanceMarkedBy", fields: [markedByUserId], references: [id], onDelete: Restrict)
  updatedByUser User? @relation("StudentAttendanceUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@unique([attendanceSessionId, studentId])
  @@index([tenantId, studentId])
  @@index([tenantId, attendanceSessionId])
  @@index([tenantId, status])
}
