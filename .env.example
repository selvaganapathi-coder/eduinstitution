# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Neon PostgreSQL
# Pooled connection used by the application runtime.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Direct connection used by Prisma CLI migrations.
DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Authentication
AUTH_SECRET=replace-with-a-long-random-secret

# Cloudflare R2
R2_ACCOUNT_ID=replace-with-cloudflare-account-id
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
R2_BUCKET_NAME=replace-with-r2-bucket-name

# Never commit a real .env file or production secrets.
